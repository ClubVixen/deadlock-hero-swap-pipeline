{
  "_comment": "First matching pattern wins. Fields are ModelDoc JiggleBone keys. jiggle_type: 0 rigid, 1 flexible, 2 neither (base spring only). Values start from the SFM .qci jiggle settings and are meant to be tuned in ModelDoc.",
  "keep_patterns": ["HairBack*", "jiggle_hair*", "TailBase", "Tail*", "jiggle_tail*", "*Breast*", "*Buttock*", "*Butt"],
  "presets": [
    {"pattern": "TailBase", "skip": true},
    {"pattern": "*Breast*", "fields": {
      "jiggle_type": 2, "has_base_spring": 1, "base_mass": 3, "base_stiffness": 90, "base_damping": 6,
      "base_left_min": -0.4, "base_left_max": 0.4, "base_left_friction": 0,
      "base_up_min": -0.5, "base_up_max": 0.5, "base_up_friction": 0,
      "base_forward_min": -0.3, "base_forward_max": 0.3, "base_forward_friction": 0}},
    {"pattern": "*Butt*", "fields": {
      "jiggle_type": 2, "has_base_spring": 1, "base_mass": 3, "base_stiffness": 120, "base_damping": 7,
      "base_left_min": -0.3, "base_left_max": 0.3, "base_left_friction": 0,
      "base_up_min": -0.4, "base_up_max": 0.4, "base_up_friction": 0,
      "base_forward_min": -0.3, "base_forward_max": 0.3, "base_forward_friction": 0}},
    {"pattern": "*ail*", "fields": {
      "jiggle_type": 1, "tip_mass": 100, "yaw_stiffness": 300, "yaw_damping": 7, "pitch_stiffness": 300, "pitch_damping": 7,
      "has_yaw_constraint": 1, "min_yaw": -90, "max_yaw": 90, "has_pitch_constraint": 1, "min_pitch": -30, "max_pitch": 30,
      "along_stiffness": 100, "along_damping": 0}},
    {"pattern": "*", "fields": {
      "jiggle_type": 1, "tip_mass": 40, "yaw_stiffness": 150, "yaw_damping": 5, "pitch_stiffness": 150, "pitch_damping": 5,
      "has_angle_constraint": 1, "angle_limit": 35, "along_stiffness": 100, "along_damping": 0}}
  ]
}
